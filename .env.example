# Node.js 24+; copy this file to .env. Never commit .env.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
APP_MODE=personal
# Required when HOST exposes the app to another device. Generate a long random value.
STUDY_ACCESS_TOKEN=
# Optional for local guided worksheets; required for conversational AI coaching.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Commercial preparation: set APP_MODE=commercial explicitly.
# Public distribution remains blocked in this preparation.
PUBLIC_RELEASE=false
PRIVATE_PILOT=false
# Required for an internet-accessible commercial pilot. APP_ORIGIN is the
# exact HTTPS app origin; an invitation restricts new pilot registrations.
APP_ORIGIN=
PILOT_INVITE_TOKEN=
# Configure operator-owned secrets on the host, never in Android/browser code.
COMMERCIAL_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
ANDROID_PACKAGE_NAME=com.aibotjock.familymedicinestudycoach
GOOGLE_SERVICE_ACCOUNT_JSON=
# Required when billing is configured: base64 of exactly 32 random bytes.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BILLING_TOKEN_ENCRYPTION_KEY=
# Empty checked-in clinical corpus intentionally produces abstentions.
GUIDELINE_CORPUS_PATH=./content/guidelines.json
PUBLIC_OPERATOR_NAME=
PUBLIC_SUPPORT_EMAIL=
# Fair-use ceilings; cost and turn limits both apply.
AI_INPUT_USD_PER_MILLION=0.75
AI_OUTPUT_USD_PER_MILLION=4.50
AI_MONTHLY_BUDGET_USD=1.00
AI_TRIAL_BUDGET_USD=0.15
AI_MONTHLY_TURN_LIMIT=200
AI_DAILY_TURN_LIMIT=20
AI_GLOBAL_MONTHLY_BUDGET_USD=20.00
