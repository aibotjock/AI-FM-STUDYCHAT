OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
CHAT_TIMEOUT_MS=90000
MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS=1200
MAX_HISTORY_MESSAGES=12
