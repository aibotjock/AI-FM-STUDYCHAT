# Node.js 24+; copy this file to .env. Never commit .env.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Required when HOST exposes the app to another device. Generate a long random value.
STUDY_ACCESS_TOKEN=
# Optional for local guided worksheets; required for conversational AI coaching.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
