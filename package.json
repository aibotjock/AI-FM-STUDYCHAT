{
  "name": "studychat-no-rag",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/start.js",
    "dev": "node --watch --env-file-if-exists=.env server/start.js",
    "test": "node --test tests/*.test.js packages/practice-engine/tests/*.test.js packages/spaced-review-engine/tests/*.test.js packages/conversation-agent/tests/*.test.js",
    "test:app": "node --test tests/*.test.js",
    "build:voice": "node tools/build-device-voice.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "esbuild": "0.28.2",
    "kokoro-js": "1.2.1"
  }
}
